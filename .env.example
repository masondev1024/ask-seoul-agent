# Default mode is deterministic and requires no external credentials.
AGENT_PROVIDER=demo
AGENT_MAX_CONCURRENT=2
LOG_LEVEL=INFO

# Optional live provider settings. For Gemini, change the first line to AGENT_PROVIDER=gemini.
# Select exactly one provider and configure only its key.
# Gemini's default is suitable for the free-tier lane; quotas and data-use terms still apply.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# External model calls remain disabled unless explicitly opted in per command.
AGENT_EVAL_LIVE=0
AGENT_LIVE_E2E=0
